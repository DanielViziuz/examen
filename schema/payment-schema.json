{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Payment",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "concept": { "type": "string" },
    "productQuantity": { "type": "integer" },
    "origin": { "type": "string" },
    "destiny": { "type": "string" },
    "totalAmount": { "type": "number" },
    "status": { "type": "string", "enum": ["NEW", "IN_PROGRESS", "SUCCESSFUL", "ERROR"] }
  }
}
